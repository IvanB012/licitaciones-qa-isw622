    {
      "id": "24587f9f-f764-5bac-8829-251c0b932bf2",
      "name": "06 · Crear proveedor",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "id": "6f73ff58-17f1-5ac4-a7db-0601fca4b771",
            "type": "text/javascript",
            "exec": [
              "// Nombre único por ejecución (letras, números y espacios) para poder repetir la colección",
              "const suf = Date.now().toString() + Math.floor(Math.random() * 1000);",
              "const nombre = \"Postman Proveedor \" + suf;",
              "pm.collectionVariables.set(\"provider_name\", nombre);",
              "// Mismo nombre con otra capitalización y espacios de más (para el caso del duplicado)",
              "pm.collectionVariables.set(\"provider_name_dup\", \"  \" + nombre.toUpperCase().replace(/ /g, \"   \") + \"  \");",
              "pm.collectionVariables.set(\"suffix\", suf);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "id": "e2425612-ffb4-583f-a308-8033616e21e3",
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201 Created\", function () { pm.response.to.have.status(201); });",
              "const p = pm.response.json();",
              "pm.test(\"Devuelve el proveedor creado\", function () { pm.expect(p.name).to.eql(pm.collectionVariables.get(\"provider_name\")); pm.expect(p.id).to.be.a(\"number\"); });",
              "pm.collectionVariables.set(\"provider_id\", p.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/providers",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "providers"
          ]
