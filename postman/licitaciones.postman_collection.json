    {
      "id": "46d116db-f32f-563c-bf0b-c8d0e5b62ff5",
      "name": "05 · Login correcto",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "c74ca581-6af0-5dfd-b2f6-5b79e10638e5",
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200 OK\", function () { pm.response.to.have.status(200); });",
              "const u = pm.response.json();",
              "pm.test(\"Devuelve usuario y rol\", function () { pm.expect(u.username).to.eql(pm.environment.get(\"username\")); pm.expect(u.role).to.be.a(\"string\"); });",
              "pm.test(\"Nunca devuelve la contraseña\", function () { pm.expect(pm.response.text().toLowerCase()).to.not.include(\"password\"); });",
              "pm.test(\"Se abre la sesión (cookie)\", function () { pm.expect(pm.cookies.has(\"session\")).to.be.true; });"
            ]
          }
        }
      ],
