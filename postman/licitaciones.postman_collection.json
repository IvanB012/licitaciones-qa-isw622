    {
      "id": "cc401479-ff53-5da7-8bc6-e7e2cb9bf2ae",
      "name": "03 · Sin sesión: listar proveedores",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "ad156eb5-2d90-50d6-810f-54ebf02f81a5",
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
              "const cuerpo = pm.response.json();",
              "pm.test(\"El cuerpo tiene exactamente {error, detalle}\", function () {",
              "  pm.expect(Object.keys(cuerpo).sort()).to.eql([\"detalle\", \"error\"]);",
              "});",
              "pm.test(\"error = no_autenticado\", function () { pm.expect(cuerpo.error).to.eql(\"no_autenticado\"); });",
              "pm.test(\"Sin trazas ni rutas internas\", function () {",
              "  const t = pm.response.text();",
              "  pm.expect(t).to.not.include(\"Traceback\"); pm.expect(t).to.not.include(\".py\");",
              "});"
            ]
          }
        }
      ],
