  },
  "item": [
    {
      "id": "6d4f9702-baf7-5059-b47e-2635b818f318",
      "name": "01 · Health: la API responde",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "675cb9a0-49bb-51cc-a76f-e38b1a0a8e8a",
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200 OK\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"status = ok\", function () { pm.expect(pm.response.json()).to.eql({ status: \"ok\" }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Sin autenticación. REQ-011."
      },
      "response": []
    },
