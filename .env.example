# Copiar a .env (nunca commitear .env)
# Para pruebas usar una BD distinta por prueba, p. ej. sqlite:///./test_<uuid>.db o sqlite:///:memory:
DATABASE_URL=sqlite:///./licitaciones.db
# Valor de ejemplo, NO es un secreto real
SECRET_KEY=cambiar-esta-clave-de-ejemplo-solo-desarrollo
# dev | test | prod  (en prod/test se ocultan detalles internos)
ENV=dev
